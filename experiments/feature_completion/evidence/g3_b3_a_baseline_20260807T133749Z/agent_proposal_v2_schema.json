{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g3-b3-agent-proposal-v2",
  "title": "G3-B3 Data-aware Agent Proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "schedule_algorithm",
    "payload_mode",
    "sparse_codec",
    "data_profile",
    "sparsity_ratio",
    "logical_bytes",
    "estimated_wire_bytes",
    "metadata_overhead",
    "estimated_compression_ratio",
    "encode_cost",
    "decode_cost",
    "chunk_size",
    "pipeline_depth",
    "credit_window",
    "integrity_policy",
    "retry_policy",
    "flow_control_policy",
    "dense_fallback_condition",
    "fallback_conditions",
    "correctness_plan",
    "validation_plan",
    "expected_benefit",
    "expected_risk",
    "proposal_hash"
  ],
  "properties": {
    "schema_version": {"const": "g3-b3-agent-proposal-v2"},
    "proposal_id": {"type": "string", "minLength": 1},
    "schedule_algorithm": {"type": "string", "minLength": 1},
    "payload_mode": {"enum": ["DENSE", "SPARSE_INDEX_VALUE"]},
    "sparse_codec": {"enum": ["NONE", "SPARSE_INDEX_VALUE"]},
    "data_profile": {"type": "string", "minLength": 1},
    "sparsity_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "logical_bytes": {"type": "integer", "minimum": 1},
    "estimated_wire_bytes": {"type": "integer", "minimum": 0},
    "metadata_overhead": {"type": "integer", "minimum": 0},
    "estimated_compression_ratio": {"type": "number", "exclusiveMinimum": 0},
    "encode_cost": {"type": "number", "minimum": 0},
    "decode_cost": {"type": "number", "minimum": 0},
    "chunk_size": {"type": "integer", "minimum": 1},
    "pipeline_depth": {"type": "integer", "minimum": 1},
    "credit_window": {"type": "integer", "minimum": 1},
    "integrity_policy": {"type": "object"},
    "retry_policy": {"type": "object"},
    "flow_control_policy": {"type": "object"},
    "dense_fallback_condition": {"type": ["string", "null"]},
    "fallback_conditions": {"type": "array", "items": {"type": "string"}},
    "correctness_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_benefit": {"type": "string", "minLength": 1},
    "expected_risk": {"type": "string", "minLength": 1},
    "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
